# .env.example — Copie para .env e ajuste para seu ambiente.
# O .env NÃO deve ser commitado (já está no .gitignore via padrão Spring).

POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=sentinelops
POSTGRES_DB=sentinelops

# Endereço Kafka para processos rodando NO HOST (Java, Rust, rpk local)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
