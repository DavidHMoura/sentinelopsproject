# Database Configuration (obrigatório — sem fallback)
DATABASE_URL=postgres://user:password@localhost:5432/sentinelops_db

# Database Pool
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2

# API Keys (obrigatório, separado por vírgula)
API_KEYS=your_secret_key_1,your_secret_key_2

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Brute-Force Detection Thresholds
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_SECONDS=300

# Port Scan Detection Thresholds
PORT_SCAN_MAX_PORTS=20
PORT_SCAN_WINDOW_SECONDS=10

# Ingestor Configuration
INGESTOR_QUEUE_CAPACITY=10000
INGESTOR_BATCH_SIZE=100
INGESTOR_FLUSH_MS=3000

# Logging
RUST_LOG=info,sentinelops_rust=debug
